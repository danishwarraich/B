# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ============================================================================
# CINEBOX CONFIGURATION — TMDB API KEY
# ============================================================================
# Configure TMDB_API_KEY via the Secrets panel in the AI Studio UI,
# or paste your official TMDB API v3 key in your local .env file.
# API Base: https://api.themoviedb.org/3
# Image Base: https://image.tmdb.org/t/p/
TMDB_API_KEY=PASTE_YOUR_TMDB_API_KEY_HERE
